    "ai_analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/AiAnalysisRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "financial_ratios": {
      "$ref": "#/$defs/FinancialRatios"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "checksum": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    }
  },
  "required": [
    "report",
    "ai_analysis",
    "financial_ratios",
    "limitations",
    "checksum"
  ],
  "title": "ResearchExport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alphasense:research-export:1.0"
}
