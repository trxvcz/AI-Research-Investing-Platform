            "pattern": "\\s$"
          },
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:[Zz]|[+-]\\d{2}:\\d{2})$",
          "title": "Available At",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceProvenance"
        },
        "report_observation_index": {
          "anyOf": [
            {
              "maximum": 999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Report Observation Index"
        },
        "filing_accession": {
          "anyOf": [
            {
              "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Filing Accession"
        }
      },
      "required": [
        "index",
        "metric",
        "unit",
        "currency",
        "value",
        "period_start",
        "period_end",
        "available_at",
        "source",
        "report_observation_index",
        "filing_accession"
      ],
