          "maxItems": 32,
          "minItems": 1,
          "title": "Snapshot Ids",
          "type": "array"
        },
        "pipeline_version": {
          "default": "manual-research-v1",
          "enum": [
            "manual-research-v1",
            "deterministic-research-v1",
            "sec-fundamentals-v1",
            "sec-fundamentals-v2"
