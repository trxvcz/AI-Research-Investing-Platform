              "enum": [
                "complete",
                "partial",
                "blocked",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Report Status"
        },
        "created_at": {
          "format": "date-time",
          "not": {
            "pattern": "\\s$"
          },
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:[Zz]|[+-]\\d{2}:\\d{2})$",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "not": {
            "pattern": "\\s$"
          },
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:[Zz]|[+-]\\d{2}:\\d{2})$",
          "title": "Updated At",
          "type": "string"
        }
