      "title": "Event Id",
      "type": "string"
    },
    "sequence": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "created",
        "start",
        "advance",
        "fail",
        "resume",
        "finish"
      ],
      "title": "Kind",
      "type": "string"
    },
    "request": {
      "discriminator": {
        "mapping": {
          "advance": "#/$defs/RunAdvance",
          "create": "#/$defs/RunCreate",
          "fail": "#/$defs/RunFail",
          "finish": "#/$defs/RunFinish",
          "resume": "#/$defs/RunResume",
          "start": "#/$defs/RunStart"
        },
        "propertyName": "action"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RunCreate"
        },
        {
          "$ref": "#/$defs/RunStart"
        },
        {
          "$ref": "#/$defs/RunAdvance"
        },
        {
          "$ref": "#/$defs/RunFail"
        },
        {
          "$ref": "#/$defs/RunResume"
        },
        {
          "$ref": "#/$defs/RunFinish"
        }
      ],
      "title": "Request"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "created_at": {
      "format": "date-time",
      "not": {
        "pattern": "\\s$"
      },
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,6})?(?:[Zz]|[+-]\\d{2}:\\d{2})$",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "event_id",
    "sequence",
    "kind",
    "request",
    "state",
    "created_at"
  ],
  "title": "RunEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alphasense:run-event:1.0"
