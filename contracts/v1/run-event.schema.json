            "queued",
            "running",
            "failed",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "current_step": {
          "anyOf": [
            {
              "enum": [
                "data",
                "validate",
                "fundamental",
                "technical",
                "report",
                "review"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Current Step"
        },
        "completed_steps": {
          "items": {
            "enum": [
              "data",
              "validate",
              "fundamental",
              "technical",
              "report",
              "review"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Completed Steps",
          "type": "array"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
