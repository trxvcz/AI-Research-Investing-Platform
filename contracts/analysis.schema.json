{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/alphasense/analysis.schema.json",
  "title": "analysis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_type": {
      "enum": [
        "equity",
        "commodity"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "fundamental": {
      "type": "object"
    },
    "technical": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "demo",
        "partial",
        "blocked",
        "complete",
        "failed"
      ]
    }
  },
  "required": [
    "asset_id",
    "asset_type",
    "as_of",
    "fundamental",
    "technical",
    "sources",
    "status"
  ]
}
